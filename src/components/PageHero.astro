---
import Image from "./Img.astro";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}
const { eyebrow, title, lead, image, imageAlt = "", imagePosition = "50% 30%" } = Astro.props;
---
<section class:list={["page-hero", "dark", { "has-image": image }]}>
  {image && (
    <div class="bg">
      <Image src={image} alt={imageAlt} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" style={`object-position:${imagePosition}`} />
    </div>
  )}
  <div class="wrap inner">
    <span class="eyebrow" data-reveal>{eyebrow}</span>
    <h1 class="h1" data-reveal style="--d:.08s"><Fragment set:html={title} /><span class="dot">.</span></h1>
    {lead && <p class="lead" data-reveal style="--d:.16s">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(9rem, 7rem + 6vw, 13rem) 0 calc(var(--radius-lg) + clamp(3rem, 2rem + 4vw, 6rem));
    background: var(--navy-950);
  }
  .bg { position: absolute; inset: 0; }
  .bg :global(img) { width: 100%; height: 100%; object-fit: cover; opacity: 0.62; filter: grayscale(0.25); }
  .bg::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(90deg, var(--navy-950) 22%, rgba(12, 19, 34, 0.6) 55%, rgba(12, 19, 34, 0.15)),
      linear-gradient(0deg, var(--navy-950), transparent 45%);
  }
  .inner { position: relative; display: grid; gap: 1.5rem; justify-items: start; }
  h1 { color: #fff; max-width: 15ch; font-size: clamp(2.6rem, 1.6rem + 4vw, 5.4rem); line-height: 1; letter-spacing: -0.045em; }
  .lead { max-width: 620px; }
</style>
