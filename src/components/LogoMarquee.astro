---
import { Image } from "astro:assets";
import { clientImg } from "../lib/assets";
import { clientLogos } from "../data/site";

const logos = clientLogos.filter((n) => clientImg[n]);
const half = Math.ceil(logos.length / 2);
const rows = [logos.slice(0, half), logos.slice(half)];
---
<div class="marquee" aria-label="Selected clients">
  {rows.map((row, i) => (
    <div class:list={["track", { reverse: i === 1 }]}>
      {[0, 1].map((dup) => (
        <ul role="list" aria-hidden={dup === 1 ? "true" : undefined}>
          {row.map((n) => (
            <li><Image src={clientImg[n]} alt={dup ? "" : n.replace(/-/g, " ")} height={56} /></li>
          ))}
        </ul>
      ))}
    </div>
  ))}
</div>

<style>
  .marquee {
    display: grid;
    gap: 1rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track { display: flex; width: max-content; animation: slide 60s linear infinite; }
  .track.reverse { animation-direction: reverse; animation-duration: 70s; }
  .marquee:hover .track { animation-play-state: paused; }
  ul { display: flex; gap: 1rem; padding-right: 1rem; }
  li {
    width: 168px;
    height: 84px;
    display: grid;
    place-items: center;
    padding: 1rem 1.4rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  li :global(img) {
    max-height: 44px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1) contrast(1.1);
    opacity: 0.72;
    transition: filter 0.3s, opacity 0.3s;
  }
  li:hover :global(img) { filter: none; opacity: 1; }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; flex-wrap: wrap; width: auto; }
    ul[aria-hidden] { display: none; }
    ul { flex-wrap: wrap; justify-content: center; }
  }
</style>
