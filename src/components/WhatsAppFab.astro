---
import Icon from "./Icon.astro";
import { wa } from "../data/site";
---
<a class="fab" href={wa("general")} target="_blank" rel="noopener" aria-label="Chat with HADE on WhatsApp">
  <Icon name="whatsapp" size={22} />
  <span>Chat with us</span>
</a>

<style>
  .fab {
    position: fixed;
    right: clamp(0.9rem, 2vw, 1.5rem);
    bottom: clamp(0.9rem, 2vw, 1.5rem);
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem;
    border-radius: 999px;
    background: var(--navy-950);
    color: #fff;
    box-shadow: 0 12px 30px -10px rgba(12, 19, 34, 0.55);
    border: 1px solid rgba(188, 148, 108, 0.45);
    font-size: 0.85rem;
    font-weight: 600;
    transition: transform 0.25s var(--ease), background 0.25s;
  }
  .fab :global(svg) { color: var(--gold-light); }
  .fab:hover { transform: translateY(-2px); background: var(--navy-800); }
  .fab span { display: none; padding-right: 0.35rem; }
  @media (min-width: 720px) { .fab span { display: inline; } .fab { padding: 0.75rem 1rem 0.75rem 0.85rem; } }
</style>
