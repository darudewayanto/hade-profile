---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
---
<Base title="Page not found">
  <PageHero eyebrow="404" title="This page took a different path" lead="The page you are looking for has moved or no longer exists.">
    <div class="btn-row">
      <a class="btn btn-gold" href={u("/")}>Back to home</a>
      <a class="btn btn-light" href={u("/contact")}>Contact us</a>
    </div>
  </PageHero>
  <div class="sheet" style="height:4rem"></div>
</Base>
