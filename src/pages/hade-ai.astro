---
import Image from "../components/Img.astro";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import CtaBand from "../components/CtaBand.astro";
import { accImg } from "../lib/assets";
import { wa } from "../data/site";

import stagePhoto from "../assets/photos/startup-stage.png";
import groupPhoto from "../assets/photos/startup-group.png";
import flow from "../assets/visuals/hade-ai-flow.png";

const steps = [
  { icon: "upload", title: "Upload", text: "Upload your documents, modules or expert material." },
  { icon: "chat", title: "Review", text: "HADE AI drafts a structured course for your experts to review and refine." },
  { icon: "sparkle", title: "Release", text: "Publish AI micro-learning that learners can study and chat with on any device." },
];

const uses = [
  { icon: "leader", title: "Executives", text: "Bite-sized learning that keeps agile transformation priorities top of mind." },
  { icon: "coach", title: "Coaches, trainers & mentors", text: "Turn your methods into scalable courses and engage learners between sessions." },
  { icon: "building", title: "Business owners", text: "Capture company know-how and onboard teams faster." },
];

const recognition = [
  { logo: "startup-world-cup", title: "Top 10 Finalist", by: "Startup World Cup" },
  { logo: "startup-istanbul", title: "World Top Finalist", by: "Startup Istanbul" },
  { logo: "founder-institute", title: "Founder Institute", by: "Silicon Valley" },
];
---
<Base title="HADE AI" description="HADE AI is an LLM knowledge converter that turns expert knowledge and documents into AI micro-learning that supports the agile transformation journey.">
  <PageHero
    eyebrow="HADE AI · AI LLM knowledge converter"
    title="Turn knowledge into learning that never stops"
    lead="Solution-based AI that uses large language models to support learning along the agile transformation journey, for executives, professionals and business owners."
    image={stagePhoto}
    imagePosition="60% 50%"
  >
    <div class="btn-row" data-reveal style="--d:.24s">
      <a class="btn btn-gold" href={wa("ai")} target="_blank" rel="noopener"><Icon name="whatsapp" /> Request a demo</a>
    </div>
  </PageHero>

  <section class="sheet section">
    <div class="wrap how">
      <div class="stack" data-reveal>
        <span class="eyebrow">How it works</span>
        <h2 class="h2">From document to course in three steps<span class="dot">.</span></h2>
        <p class="lead">HADE AI turns static material into engaging micro-learning that your people can learn from and chat with.</p>
        <ol role="list" class="steps">
          {steps.map((s, i) => (
            <li>
              <span class="st-icon"><Icon name={s.icon} /></span>
              <div><strong>{String(i + 1).padStart(2, "0")} · {s.title}</strong><p class="muted small">{s.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="flow card" data-reveal style="--d:.1s">
        <Image src={flow} alt="HADE AI turning a document into a mobile course" width={1100} />
      </div>
    </div>
  </section>

  <section class="section sand">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <div><span class="eyebrow">Built for</span><h2 class="h2" style="margin-top:1rem">Learning that fits the way leaders work<span class="dot">.</span></h2></div>
        <p class="lead">AI micro-learning and learning engagement, designed alongside HADE's coaching programs.</p>
      </div>
      <ul role="list" class="uses">
        {uses.map((u, i) => (
          <li class="card" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="u-icon"><Icon name={u.icon} /></span>
            <h3>{u.title}</h3>
            <p class="muted">{u.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap rec">
      <div class="stack" data-reveal>
        <span class="eyebrow">Global recognition</span>
        <h2 class="h2">Recognized on the world startup stage<span class="dot">.</span></h2>
        <ul role="list" class="rec-list">
          {recognition.map((r) => (
            <li>
              <span class="rl"><Image src={accImg[r.logo]} alt="" height={56} /></span>
              <span><strong>{r.title}</strong><br /><span class="muted small">{r.by}</span></span>
            </li>
          ))}
        </ul>
      </div>
      <div class="media rec-photo" data-reveal style="--d:.1s">
        <Image src={groupPhoto} alt="HADE AI team with finalists at an international startup competition" width={1000} />
      </div>
    </div>
  </section>

  <CtaBand title="See HADE AI with your own content." text="Send us a message and we will arrange a demo using one of your learning materials." />
</Base>

<style>
  .how { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 960px) { .how { grid-template-columns: 1fr 1.1fr; gap: 5rem; } }
  .steps { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .steps li { display: flex; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); align-items: flex-start; }
  .st-icon { width: 44px; height: 44px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--navy-950); color: var(--gold-light); }
  .flow { padding: 1rem; background: #fff; }

  .uses { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .uses li { display: grid; gap: 0.75rem; align-content: start; }
  .uses h3 { font-size: 1.2rem; font-weight: 600; letter-spacing: -0.02em; }
  .u-icon { width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line-strong); color: var(--gold-deep); }

  .rec { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 960px) { .rec { grid-template-columns: 1fr 1.1fr; gap: 5rem; } }
  .rec-list { display: grid; border-top: 1px solid var(--line); }
  .rec-list li { display: flex; gap: 1.25rem; align-items: center; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .rl { width: 120px; flex: none; display: flex; align-items: center; }
  .rl :global(img) { max-height: 52px; width: auto; max-width: 120px; object-fit: contain; }
  .rec-photo { aspect-ratio: 4 / 3; }
</style>
