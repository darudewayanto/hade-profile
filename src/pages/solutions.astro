---
import { u } from "../lib/url";
import Image from "../components/Img.astro";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import CtaBand from "../components/CtaBand.astro";
import TransformationDiagrams from "../components/TransformationDiagrams.astro";
import { accImg } from "../lib/assets";
import { corporatePrograms, coreSolutions, wa } from "../data/site";

import stage from "../assets/photos/daru-stage.jpg";
import safe1 from "../assets/visuals/safe-1.png";
import safe2 from "../assets/visuals/safe-2.png";

---
<Base title="Solutions" description="Business agility transformation, agile coaching competencies, applied-neuroscience profiling and AI learning, customized for corporations and governments.">
  <PageHero
    eyebrow="Solutions"
    title="End-to-end agile culture transformation"
    lead="Customized programs for people and leadership development, designed together with each client."
    image={stage}
    imagePosition="50% 20%"
  >
    <div class="btn-row" data-reveal style="--d:.24s">
      <a class="btn btn-gold" href={wa("inhouse")} target="_blank" rel="noopener"><Icon name="whatsapp" /> Discuss your program</a>
    </div>
  </PageHero>

  <!-- Transformation design -->
  <section class="sheet section">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <div><h2 class="h2">Our agile transformation guideline, co-created with you</h2></div>
        <p class="lead">Every HADE program follows the guideline shown below. We agree the starting point and goals with your leaders, then shape the workshops, certification and mentoring to fit your organization.</p>
      </div>
      <TransformationDiagrams />
    </div>
  </section>

  <!-- Core positioning -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <div><h2 class="h2">Core positioning</h2></div>
        <p class="lead">HADE works in three areas: business agility transformation, agile coaching competencies and HADE AI.</p>
      </div>
      <div class="core">
        <article class="core-item" id="transformation" data-reveal>
          <span class="num">01</span>
          <div>
            <h3 class="h3">Business Agility Transformation</h3>
            <p class="muted">Agile culture transformation for people and leadership development, with agile team and leadership programs customized for each client.</p>
          </div>
          <ul class="check-list small">
            {coreSolutions.map((c) => <li><strong>{c.title}</strong>: {c.text}</li>)}
          </ul>
        </article>
        <article class="core-item" id="competencies" data-reveal>
          <span class="num">02</span>
          <div>
            <h3 class="h3">Agile Coaching Competencies</h3>
            <p class="muted">Agile coaching is the core competency leaders need to guide an agile transformation. HADE is the only firm in the region holding international accreditation in agile coaching from three major organizations: ICF, ICAgile and MyBrain.</p>
          </div>
          <ul class="check-list small">
            <li>Agile coaching certification (in-house &amp; public)</li>
            <li>Workshops &amp; training on agile coaching competency</li>
            <li>1-on-1 &amp; group sessions</li>
          </ul>
          <a class="link-arrow" href={u("/certification")}>Explore the ACHC certification <Icon name="arrow-right" /></a>
        </article>
        <article class="core-item" id="ai" data-reveal>
          <span class="num">03</span>
          <div>
            <h3 class="h3">HADE AI</h3>
            <p class="muted">Solution-based AI that uses large language models to support learning along the agile transformation journey. It is designed for executives, professionals (coaches, trainers and mentors) and business owners.</p>
          </div>
          <ul class="check-list small">
            <li>AI micro-learning</li>
            <li>AI learning engagement</li>
            <li>Knowledge converter for your experts</li>
          </ul>
          <a class="link-arrow" href={u("/hade-ai")}>Discover HADE AI <Icon name="arrow-right" /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- Corporate -->
  <section class="section" id="corporate">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <div><h2 class="h2">Corporate &amp; enterprise programs</h2></div>
        <p class="lead">The programs our corporate clients ask for most, delivered in-house or in public batches.</p>
      </div>
      <ul role="list" class="prog-list">
        {corporatePrograms.map((p) => (
          <li class:list={["prog", { "prog-linked": p.href }]} data-reveal>
            <h3>{p.href ? <a class="prog-link" href={u(p.href)}>{p.title}</a> : p.title}</h3>
            <p class="muted">{p.text}</p>
            <ul class="prog-items small">{p.items.map((it) => <li>{it}</li>)}</ul>
            {p.href && <span class="prog-more" aria-hidden="true">View program <Icon name="arrow-right" size={16} /></span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Profiling -->
  <section class="section sand" id="profiling">
    <div class="wrap split">
      <div class="stack" data-reveal>
        <h2 class="h2">MyBrain Neuro-Dominance profiling</h2>
        <p class="lead">Understand how each leader and team prefers to think, decide and act, and use it to build better teams.</p>
        <ul class="check-list">
          <li><strong>Individual profile:</strong> personal and professional thinking preferences across reasoning, spontaneous, specific and feeling dimensions</li>
          <li><strong>Team profile:</strong> the collective thinking pattern of a team, to balance roles and reduce friction</li>
          <li><strong>Agile Health Check-up:</strong> leader, team and organization assessment</li>
        </ul>
        <div class="acc-row">
          <Image src={accImg["mybrain"]} alt="MyBrain International" height={40} />
          <Image src={accImg["mind-master"]} alt="MIND Master Practitioner" height={56} />
        </div>
      </div>
      <div class="profile-visuals" data-reveal style="--d:.1s">
        <img src={u("/solutions/mind-individual-profile.png")} width="508" height="355" alt="MyBrain individual profile: personal and professional thinking preferences across reasoning, spontaneous, specific and feeling" loading="lazy" decoding="async" />
        <img src={u("/solutions/mind-team-profile.png")} width="583" height="355" alt="MyBrain team profile: the team's combined thinking preferences and member-by-member charts" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- Business agility framework -->
  <section class="section">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <div><h2 class="h2">Scaled agility, guided by SAFe 6.0</h2></div>
        <p class="lead">We use the Scaled Agile Framework (SAFe) 6.0 as a reference model and adapt it to your organization's maturity.</p>
      </div>
      <div class="safe" data-reveal>
        <div class="card"><Image src={safe1} alt="Business agility competencies overview" width={1000} /></div>
        <div class="card"><Image src={safe2} alt="SAFe 6.0 business agility framework" width={1000} /></div>
      </div>
    </div>
  </section>

  <CtaBand title="Let's design your agile transformation program." />
</Base>

<style>
  .core { display: grid; gap: 1.25rem; }
  .core-item {
    display: grid; gap: 1.25rem 3rem; padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius); background: var(--paper); border: 1px solid var(--line);
    scroll-margin-top: 7rem;
  }
  @media (min-width: 900px) { .core-item { grid-template-columns: 70px 1.1fr 1fr; align-items: start; } .core-item .link-arrow { grid-column: 3; justify-self: start; } }
  .core-item .num { font-size: 2.2rem; letter-spacing: -0.04em; color: var(--gold); line-height: 1; }
  .core-item > div { display: grid; gap: 0.75rem; }


  #corporate, #profiling { scroll-margin-top: 4rem; }
  .prog-list { border-top: 1px solid var(--line-strong); }
  .prog { position: relative; display: grid; gap: 0.5rem 3rem; padding: 1.75rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { .prog { grid-template-columns: 0.9fr 1.1fr 1fr; align-items: start; } }
  .prog h3 { font-size: 1.3rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.25; }
  .prog-items { list-style: none; padding: 0; display: grid; gap: 0.35rem; color: var(--ink-soft); }
  .prog-items li::before { content: "– "; color: var(--gold-deep); }
  .prog-link { color: inherit; }
  .prog-link::after { content: ""; position: absolute; inset: 0; z-index: 2; }
  .prog-linked:hover h3 { color: var(--gold-deep); }
  .prog-more { grid-column: 1 / -1; display: inline-flex; align-items: center; gap: 0.4em; font-size: var(--fs-small); font-weight: 600; color: var(--gold-deep); }
  @media (min-width: 900px) { .prog-more { grid-column: 1; } }

  .split { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 900px) { .split { grid-template-columns: 1fr 1fr; gap: 5rem; } }
  .acc-row { display: flex; gap: 1.25rem; align-items: center; }
  .acc-row :global(img) { width: auto; }
  /* Supplied images (508px & 583px wide): shown as-is, aligned at 508px so neither is ever upscaled. */
  .profile-visuals { display: grid; gap: 1.25rem; justify-items: center; }
  .profile-visuals img { width: 100%; max-width: 508px; height: auto; }

  .safe { display: grid; gap: 1rem; }
  @media (min-width: 900px) { .safe { grid-template-columns: 1fr 1fr; } }
  .safe .card { padding: 0.75rem; }
  .safe :global(img) { border-radius: 10px; }
</style>
